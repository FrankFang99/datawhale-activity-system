# ===================================================================
# Datawhale 高校活动智能管理系统 · 后端 .env 模板
# ===================================================================
# 复制为 .env，按需修改
# 完整部署指南见 DEPLOY.md §7
# ===================================================================

# ===== 服务配置 =====
NODE_ENV=development
PORT=4000
# CORS 必须包含前端实际域名（多域名逗号分隔）
CORS_ORIGIN=http://localhost:5173

# ===== JWT 配置 =====
# 32+ 字符的随机串，用于签发 token
# 生成命令：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=datawhale-dev-secret-change-me-in-production-please-replace-with-random-48-bytes
JWT_EXPIRES_IN=86400

# ===== 飞书 App 配置 =====
# 飞书企业版应用凭证（Datawhale IT 在飞书后台 → 应用详情 → 凭证与基础信息获取）
# lark-cli auth login --app-id <APP_ID> --app-secret <APP_SECRET>
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 飞书 Base 配置（运行 setup_all_tables.py 自动写入）=====
# 11 张业务表 + base_token。手动配可参考 DEPLOY.md §7.1
FEISHU_BASE_TOKEN=
FEISHU_TABLE_USERS=
FEISHU_TABLE_ACTIVITIES=
FEISHU_TABLE_APPLICATIONS=
FEISHU_TABLE_STAGE_TASKS=
FEISHU_TABLE_REIMBURSEMENTS=
FEISHU_TABLE_CHAT_LOGS=
FEISHU_TABLE_PARTICIPANTS=
FEISHU_TABLE_INTERESTS=
FEISHU_TABLE_MESSAGES=
FEISHU_TABLE_MATERIALS=
# FEISHU_TABLE_NOTIFICATION_LOGS=  # v1 暂未启用，预留

# ===== 邮件通知（v1 stub · 生产环境建议接 SMTP）=====
# v1 默认 console.log stub（仅输出到日志）
# 接 SMTP 需 Datawhale IT 提供凭证
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@datawhale.cn
# SMTP_PASSWORD=xxxxxxxxxxxx
# SMTP_FROM="Datawhale 活动系统 <noreply@datawhale.cn>"

# ===== 飞书告警（关键错误 → 飞书群机器人）=====
# Datawhale IT 在飞书群 → 设置 → 群机器人 → 自定义机器人 → 复制 webhook URL
# 留空 = 关闭告警（v1 测试模式默认）
LARK_ALERT_WEBHOOK_URL=
# 告警级别阈值：DEBUG / INFO / WARN / ERROR / FATAL
LARK_ALERT_LEVEL=ERROR
# 是否启用告警（dev 模式可以关）
LARK_ALERT_ENABLED=true

# ===== 通知收件人 =====
# v1 测试模式（Frank 一人 7 角色测试）用：NOTIFY_TEST_MODE=true
# 生产环境务必改 false + 按角色发到不同人
NOTIFY_TEST_MODE=true
NOTIFY_DEFAULT_EMAIL=frank-fangyz@139.com

# ===== 业务阈值（5 维评分 · 可按 Datawhale 业务调整）=====
# 等级阈值（0-100 分）
SCORE_GRADE_S=90
SCORE_GRADE_A=75
SCORE_GRADE_B=60
SCORE_GRADE_C=40
# 5 维权重（合计必须 = 100）
SCORE_WEIGHT_VENUE=20
SCORE_WEIGHT_RECRUIT=20
SCORE_WEIGHT_EXPERIENCE=25
SCORE_WEIGHT_TIMING=15
SCORE_WEIGHT_VALUE=20

# ===== 报销阈值 =====
# 单笔金额上限（元）
REIMBURSEMENT_MAX_AMOUNT=10000
# 单笔金额下限（元）
REIMBURSEMENT_MIN_AMOUNT=1
